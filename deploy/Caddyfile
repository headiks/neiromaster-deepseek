# Вход снаружи: HTTPS -> web:8000. Адрес — переменная SITE_ADDRESS (docker-compose.yml):
#   домен (nm.company.ru)   — сертификат Let's Encrypt автоматически, нужен интернет;
#   IP-адрес или localhost  — сертификат внутреннего CA Caddy, работает без интернета.
# Корпоративный сертификат: смонтируйте его в контейнер и добавьте в блок
#   tls /certs/cert.pem /certs/key.pem
{$SITE_ADDRESS:localhost} {
	reverse_proxy web:8000
}

# Демо для показа клиентам — отдельный экземпляр со своей БД (web-demo). Адрес —
# DEMO_SITE_ADDRESS (по умолчанию demo.localhost; для домена — demo.nm.company.ru).
{$DEMO_SITE_ADDRESS:demo.localhost} {
	reverse_proxy web-demo:8000
}
